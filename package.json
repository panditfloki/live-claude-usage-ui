{
  "name": "claude-usage-meter",
  "displayName": "Mātrā — Claude + Codex + Gemini Usage",
  "description": "Live Claude, Codex, and Gemini usage — plan limits, tokens and equivalent API cost in one local dashboard.",
  "version": "1.3.0",
  "publisher": "dydxfx",
  "author": {
    "name": "Pandit Floki",
    "email": "pandit@dydxfx.com",
    "url": "https://dydxfx.com"
  },
  "license": "MIT",
  "homepage": "https://dydxfx.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/panditfloki/live-claude-usage-ui.git"
  },
  "bugs": {
    "url": "https://github.com/panditfloki/live-claude-usage-ui/issues",
    "email": "pandit@dydxfx.com"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "antigravity",
    "usage",
    "quota",
    "dashboard",
    "status-bar",
    "anthropic"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.open",
        "title": "Mātrā: Open Dashboard"
      },
      {
        "command": "claudeUsage.refresh",
        "title": "Mātrā: Refresh Now"
      }
    ],
    "configuration": {
      "title": "Mātrā Usage Meter",
      "properties": {
        "claudeUsage.statusBar.metric": {
          "type": "string",
          "enum": [
            "quota",
            "cost",
            "today",
            "total"
          ],
          "default": "quota",
          "enumDescriptions": [
            "Claude session quota, Codex primary quota, and Gemini primary quota, kept separate",
            "Claude current-window cost, Codex primary quota, and Gemini primary quota",
            "Claude, Codex, and Gemini calendar-today costs, kept separate",
            "Claude, Codex, and Gemini all-time costs, kept separate"
          ],
          "description": "Which figure the status bar shows."
        },
        "claudeUsage.statusBar.show": {
          "type": "boolean",
          "default": true,
          "description": "Show the live burn counter in the status bar."
        }
      }
    }
  },
  "scripts": {
    "dev": "node server.js",
    "package": "vsce package",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0"
  }
}
